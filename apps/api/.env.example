# ==========================================
# REPOSAGE BACKEND CONFIGURATION (apps/api)
# Copy to apps/api/.env — never commit the real file.
# ==========================================
PORT=4000
# Interface to bind. Keep 127.0.0.1: the API has no user auth and acts with your gh session.
HOST=127.0.0.1
# Comma-separated list of web UI origins allowed to call the API.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Local Ollama Gemma 4 Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_GEMMA_MODEL=gemma4:e4b
OLLAMA_TIMEOUT_MS=60000

# Google AI Studio Hosted Gemma 4 Configuration
GOOGLE_AI_API_KEY=your_google_ai_studio_api_key_here
HOSTED_GEMMA_MODEL=gemma-4-26b-a4b-it
# Gemma 4 26B reasons before answering; full audits typically take 30-90 s.
HOSTED_TIMEOUT_MS=120000

# Groq fallback for the hosted slot (used when Google AI Studio fails or has no key).
# Never used in Local Privacy Mode. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000

# Collector & Compiler Limits
MAX_FILE_BYTES=65536
MAX_EVIDENCE_BYTES=524288
MAX_MANIFEST_TOKENS=2500

# Logging: debug | info | warn | error
LOG_LEVEL=info
