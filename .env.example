# ==============================================================================
# Environment Configuration Template: HacktoberFest-x-Fluxxion
# ==============================================================================
# Copy this file to .env and customize the variables for your local setup.
# DO NOT commit .env or real credentials into version control!
# ==============================================================================

# Server / Application Environment
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
LOG_LEVEL=info

# Open-Source / Open-Weight AI Model Settings
# Options: gemma:2b, gemma:7b, hermes-3, llama3.2, mistral, etc.
MODEL_NAME=gemma:2b
MODEL_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Hugging Face Token (Needed only for downloading gated open-weight models from HF Hub)
# Leave blank when using fully local Ollama instances
HUGGINGFACE_HUB_TOKEN=your_huggingface_read_token_here

# Optional: Cloud Deployment / Storage (e.g. DigitalOcean Spaces or Droplet hosting)
# DIGITALOCEAN_SPACES_KEY=your_spaces_key_here
# DIGITALOCEAN_SPACES_SECRET=your_spaces_secret_here
# DIGITALOCEAN_REGION=fra1
